# --- Anthropic ---
ANTHROPIC_API_KEY=sk-ant-your-key-here

# --- Meraki ---
MERAKI_API_KEY=your-meraki-api-key-here
MERAKI_BASE_URL=https://api.meraki.com/api/v1

# --- Claude model ---
CLAUDE_MODEL=claude-haiku-4-5-20251001

# --- JWT ---
# Generate a strong random secret with:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=change-me-to-a-random-256-bit-secret
JWT_EXPIRE_MINS=480

# --- Users (JSON) ---
# Hash a password with:
#   python3 -c "from passlib.context import CryptContext; print(CryptContext(schemes=['bcrypt']).hash('yourpassword'))"
# Then paste the hash below. You can add multiple users.
USERS_JSON={"admin": "$2b$12$paste-your-hashed-password-here"}
